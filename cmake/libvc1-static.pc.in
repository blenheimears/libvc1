prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libvc1-static
Description: VC-1 encoder library (static linkage)
Version: @PROJECT_VERSION@
Libs: ${libdir}/@CMAKE_STATIC_LIBRARY_PREFIX@@LIBVC1_STATIC_PC_BASENAME@@CMAKE_STATIC_LIBRARY_SUFFIX@ @LIBVC1_PC_PRIVATE@
Cflags: -I${includedir} -DLIBVC1_STATIC=1
